{
  "name": "taekwondo-motion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode qa",
    "dev:qa": "vite --mode qa",
    "build": "vite build",
    "build:qa": "vite build --mode qa --outDir dist-qa",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "content:validate": "node --import tsx scripts/validate.ts content",
    "assets:validate": "node --import tsx scripts/validate.ts assets",
    "release:check": "node --import tsx scripts/validate.ts release",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "dev:public": "vite --mode production"
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "lucide-react": "^0.552.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/node": "24.9.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.38.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12"
  }
}
